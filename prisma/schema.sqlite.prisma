// AppIcon - Prisma Schema
// App 图标生成器数据模型
// 开发测试使用 SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ============================================
// 用户表
// ============================================
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  image         String?
  
  // 积分系统（可选）
  credits       Int          @default(0)
  
  // 免费额度
  freeCredits   Int          @default(1)
  
  // 关联
  generations   Generation[]
  payments      Payment[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([email])
}

// ============================================
// 图标生成任务
// ============================================
model Generation {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 输入信息
  appName       String
  description   String
  style         String
  
  // 状态
  status        String       @default("pending")
  error         String?
  
  // 生成结果
  results       IconResult[]
  selectedId    String?
  
  // 付费状态
  paid          Boolean      @default(false)
  paidAt        DateTime?
  tier          String?
  
  // 关联支付
  payment       Payment?
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
}

// ============================================
// 单个图标结果
// ============================================
model IconResult {
  id            String      @id @default(cuid())
  generationId  String
  generation    Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
  
  imageUrl      String
  svgUrl        String?
  thumbUrl      String?
  prompt        String
  seed          Int?
  width         Int?
  height        Int?
  
  createdAt     DateTime    @default(now())

  @@index([generationId])
}

// ============================================
// 支付记录
// ============================================
model Payment {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripePaymentIntentId   String?   @unique
  stripeCheckoutSessionId String?   @unique
  
  amount                  Int
  currency                String    @default("usd")
  status                  String    @default("pending")
  
  generationId            String?   @unique
  generation              Generation?  @relation(fields: [generationId], references: [id])
  
  tier                    String?
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}